{
  "manifest_version": 3,
  "name": "Scroll Break",
  "version": "1.0.0",
  "description": "Take a break from YouTube Shorts after watching for a set time.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Scroll Break settings"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "scroll-break@local",
      "strict_min_version": "109.0"
    }
  }
}
